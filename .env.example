# NextM 环境配置
# 复制为 .env 并修改

# 服务
NEXTM_LISTEN_ADDR=:8080
NEXTM_LOG_LEVEL=debug

# 本地数据库 (SQLite)
NEXTM_DATABASE_SQLITE_PATH=./data/nextm.db

# 云端数据库 (PostgreSQL)
NEXTM_DATABASE_POSTGRES_DSN=postgres://nextm:nextm@localhost:5432/nextm?sslmode=disable

# Redis (Asynq + Cache)
NEXTM_REDIS_ADDR=localhost:6379
NEXTM_REDIS_PASSWORD=

# NATS
NEXTM_NATS_URL=nats://localhost:4222

# Meilisearch
NEXTM_MEILISEARCH_HOST=http://localhost:7700
NEXTM_MEILISEARCH_API_KEY=

# LiteLLM
NEXTM_LITELLM_URL=http://localhost:4000
NEXTM_LITELLM_API_KEY=

# JWT
NEXTM_JWT_SECRET=change-me-to-a-random-secret
NEXTM_JWT_ACCESS_TTL=15m
NEXTM_JWT_REFRESH_TTL=168h
